    "@types/sortablejs": "^1.15.9",
    "fake-indexeddb": "^6.2.7",
    "fontkit": "^2.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
